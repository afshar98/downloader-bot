# Required; keep the real bot token in the ignored .env file.
TELEGRAM_BOT_TOKEN=

# Trusted locally installed executables and their expected version tokens.
YT_DLP_PATH=yt-dlp
YT_DLP_EXPECTED_VERSION=replace-with-approved-version
FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_EXPECTED_VERSION=replace-with-approved-version

# Optional limits; values may be lowered but cannot exceed application hard caps.
MAX_MEDIA_BYTES=20971520
MAX_GIF_BYTES=15728640
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MS=180000
