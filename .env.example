# Required for local long-polling. Keep the real token in .env, which is ignored.
TELEGRAM_BOT_TOKEN=

# Trusted executable supplied by the deployment; startup checks its version.
YT_DLP_PATH=yt-dlp
YT_DLP_EXPECTED_VERSION=yt-dlp 2026.09.01

# Bounded operations (milliseconds)
EXTRACTION_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=60000
PROCESSING_TIMEOUT_MS=60000
DELIVERY_TIMEOUT_MS=30000
JOB_TIMEOUT_MS=115000
SHUTDOWN_GRACE_MS=30000

# Limits
MAX_MEDIA_BYTES=51380224
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=8
MAX_YTDLP_STDOUT_BYTES=1048576
MAX_YTDLP_STDERR_BYTES=65536
MAX_METADATA_BYTES=1048576
MAX_REDIRECTS=3
MAX_OPEN_DOWNLOADS=2

# Storage and logging
TEMP_DIR=/tmp
LOG_LEVEL=info
